+func TestCSV(t *testing.T) {
+	out, err := Render([]store.Item{
+		{SKU: "A", Name: `say "hi", ok`, Qty: 2, Price: 1.5},
+		{SKU: "B", Name: "x\ny", Qty: 0, Price: 3},
+	}, "csv")
+	want := "sku,name,qty,price\nA,\"say \"\"hi\"\", ok\",2,1.50\nB,\"x\ny\",0,3.00\n"
+	if err != nil || out != want {
+		t.Fatalf("csv: %q %v", out, err)
+	}
+}
