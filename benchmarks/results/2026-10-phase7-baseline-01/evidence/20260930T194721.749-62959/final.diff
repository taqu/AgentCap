+func csvFormat(items []store.Item) string {
+	var b strings.Builder
+	b.WriteString("sku,name,qty,price\n")
+	for _, it := range items {
+		fmt.Fprintf(&b, "%s,%s,%d,%.2f\n", csvField(it.SKU), csvField(it.Name), it.Qty, it.Price)
+	}
+	return b.String()
+}
+
+// csvField quotes s per RFC 4180 when it contains a comma, quote or newline.
+func csvField(s string) string {
+	if !strings.ContainsAny(s, ",\"\r\n") {
+		return s
+	}
+	return `"` + strings.ReplaceAll(s, `"`, `""`) + `"`
+}
